{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/woodsstudiosupport/cloverstoresupports/main/schemas/announcement.schema.json",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "maxLength": 100
    },
    "developerId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "maxLength": 100
    },
    "appIds": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,199}$",
        "not": {
          "const": "null"
        }
      },
      "uniqueItems": true
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 150
    },
    "body": {
      "type": "string",
      "minLength": 1,
      "maxLength": 8000
    },
    "publishedAt": {
      "type": "string",
      "format": "date-time"
    },
    "expiresAt": {
      "type": "string",
      "format": "date-time"
    },
    "url": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://",
      "maxLength": 4096
    }
  },
  "required": [
    "id",
    "developerId",
    "title",
    "body",
    "publishedAt"
  ],
  "additionalProperties": false
}
