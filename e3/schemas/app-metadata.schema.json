{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "E3 app metadata",
  "type": "object",
  "required": [
    "schemaVersion",
    "apps"
  ],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "apps": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "facts": {
            "type": "object",
            "propertyNames": {
              "enum": [
                "noAds",
                "noAccount",
                "offline",
                "noSubscriptions",
                "openSource"
              ]
            },
            "additionalProperties": {
              "type": "object",
              "required": [
                "value",
                "source"
              ],
              "properties": {
                "value": {
                  "type": "boolean"
                },
                "source": {
                  "enum": [
                    "publisher",
                    "inspection",
                    "independent"
                  ]
                },
                "checkedAt": {
                  "type": "string",
                  "format": "date-time"
                },
                "evidenceUrl": {
                  "type": "string",
                  "format": "uri"
                }
              }
            }
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "alternatives": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "ramBytes": {
            "type": "integer",
            "minimum": 1
          },
          "lastReleaseAt": {
            "type": "string",
            "format": "date-time"
          },
          "setupEstimate": {
            "type": "string"
          },
          "demoUrl": {
            "type": "string",
            "format": "uri"
          },
          "cost": {
            "type": "object",
            "properties": {
              "label": {
                "type": "string"
              },
              "details": {
                "type": "string"
              }
            }
          },
          "privacy": {
            "type": "object",
            "properties": {
              "permissions": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "trackers": {
                "type": "boolean"
              },
              "collectionSummary": {
                "type": "string"
              },
              "source": {
                "enum": [
                  "publisher",
                  "inspection",
                  "independent"
                ]
              }
            }
          },
          "declarations": {
            "type": "object",
            "required": [
              "ads",
              "account",
              "offline",
              "subscriptions",
              "openSource"
            ],
            "additionalProperties": false,
            "properties": {
              "ads": {
                "enum": [
                  "yes",
                  "no",
                  "n/a"
                ]
              },
              "account": {
                "enum": [
                  "yes",
                  "no",
                  "n/a"
                ]
              },
              "offline": {
                "enum": [
                  "yes",
                  "no",
                  "n/a"
                ]
              },
              "subscriptions": {
                "enum": [
                  "yes",
                  "no",
                  "n/a"
                ]
              },
              "openSource": {
                "enum": [
                  "yes",
                  "no",
                  "n/a"
                ]
              }
            }
          }
        }
      }
    }
  }
}
